<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<RootNamespace>BetterCounterOffer</RootNamespace>
		<LangVersion>latest</LangVersion>
		<IsPackable>false</IsPackable>
		<AssemblyVersion>3.4.1</AssemblyVersion>
		<FileVersion>3.4.1</FileVersion>
		<NeutralLanguage>en-US</NeutralLanguage>
		<Configurations>IL2CPP;MONO</Configurations>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<!-- Privacy & Security: Prevent local paths/usernames from leaking into compiled DLL -->
		<Deterministic>true</Deterministic>
		<PathMap>$(MSBuildProjectDirectory)=/BetterCounterOffer</PathMap>
		<DebugSymbols>false</DebugSymbols>
		<DebugType>none</DebugType>

		<!-- Path to Schedule I game directory; can be overridden via /p:S1Dir="..." or environment variable -->
		<S1Dir Condition="'$(S1Dir)' == ''">$(SCHEDULE1_DIR)</S1Dir>
		<S1Dir Condition="'$(S1Dir)' == ''">..</S1Dir>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'IL2CPP' Or '$(Configuration)' == ''">
		<TargetFramework>net6.0</TargetFramework>
		<AssemblyName>$(RootNamespace)_IL2Cpp_$(FileVersion)</AssemblyName>
		<DefineConstants>IL2CPP</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'MONO'">
		<TargetFramework>netstandard2.1</TargetFramework>
		<AssemblyName>$(RootNamespace)_Mono_$(FileVersion)</AssemblyName>
		<DefineConstants>MONO</DefineConstants>
	</PropertyGroup>

	<!-- IL2CPP Dependencies -->
	<ItemGroup Condition="'$(Configuration)' == 'IL2CPP' Or '$(Configuration)' == ''">
		<Reference Include="MelonLoader">
			<HintPath>$(S1Dir)\MelonLoader\net6\MelonLoader.dll</HintPath>
		</Reference>
		<Reference Include="0Harmony">
			<HintPath>$(S1Dir)\MelonLoader\net6\0Harmony.dll</HintPath>
		</Reference>
		<Reference Include="Il2CppInterop.Runtime">
			<HintPath>$(S1Dir)\MelonLoader\net6\Il2CppInterop.Runtime.dll</HintPath>
		</Reference>
		<Reference Include="Il2Cppmscorlib">
			<HintPath>$(S1Dir)\MelonLoader\Il2CppAssemblies\Il2Cppmscorlib.dll</HintPath>
		</Reference>
		<Reference Include="Il2CppSystem">
			<HintPath>$(S1Dir)\MelonLoader\Il2CppAssemblies\Il2CppSystem.dll</HintPath>
		</Reference>
		<Reference Include="Il2CppFishNet.Runtime">
			<HintPath>$(S1Dir)\MelonLoader\Il2CppAssemblies\Il2CppFishNet.Runtime.dll</HintPath>
		</Reference>
		<Reference Include="Assembly-CSharp">
			<HintPath>$(S1Dir)\MelonLoader\Il2CppAssemblies\Assembly-CSharp.dll</HintPath>
		</Reference>
		<Reference Include="Il2CppScheduleOne.Core">
			<HintPath>$(S1Dir)\MelonLoader\Il2CppAssemblies\Il2CppScheduleOne.Core.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine">
			<HintPath>$(S1Dir)\MelonLoader\Il2CppAssemblies\UnityEngine.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.CoreModule">
			<HintPath>$(S1Dir)\MelonLoader\Il2CppAssemblies\UnityEngine.CoreModule.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.UI">
			<HintPath>$(S1Dir)\MelonLoader\Il2CppAssemblies\UnityEngine.UI.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.UIModule">
			<HintPath>$(S1Dir)\MelonLoader\Il2CppAssemblies\UnityEngine.UIModule.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.TextRenderingModule">
			<HintPath>$(S1Dir)\MelonLoader\Il2CppAssemblies\UnityEngine.TextRenderingModule.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.IMGUIModule">
			<HintPath>$(S1Dir)\MelonLoader\Il2CppAssemblies\UnityEngine.IMGUIModule.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.InputLegacyModule">
			<HintPath>$(S1Dir)\MelonLoader\Il2CppAssemblies\UnityEngine.InputLegacyModule.dll</HintPath>
		</Reference>
		<Reference Include="Unity.TextMeshPro">
			<HintPath>$(S1Dir)\MelonLoader\Il2CppAssemblies\Unity.TextMeshPro.dll</HintPath>
		</Reference>
	</ItemGroup>
</Project>